# === Credenciais da JSearch API (RapidAPI) ===
# 1. Crie uma conta em https://rapidapi.com
# 2. Assine (plano gratuito) a API "JSearch": https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# 3. Copie sua "X-RapidAPI-Key" e cole abaixo
RAPIDAPI_KEY=coloque_sua_chave_aqui

# === Credenciais do CallMeBot (WhatsApp) ===
# 1. Adicione o número +34 644 59 71 67 nos seus contatos do WhatsApp
# 2. Envie a mensagem: "I allow callmebot to send me messages"
# 3. Você vai receber uma API Key por mensagem. Cole abaixo.
# 4. Coloque seu número de telefone COM código do país, sem espaços/símbolos (ex: 5511999999999)
WHATSAPP_PHONE=coloque_seu_numero_aqui
CALLMEBOT_APIKEY=coloque_sua_apikey_aqui

# === Configurações de busca ===
# Palavras-chave separadas por vírgula
SEARCH_KEYWORDS=estágio segurança da informação,estágio cibersegurança,estágio defesa cibernética,estágio TI,jovem aprendiz tecnologia,suporte técnico,helpdesk,estágio infraestrutura,estágio redes

# País alvo (código ISO de 2 letras)
SEARCH_COUNTRY=br

# Vagas postadas nos últimos: today | 3days | week | month
DATE_POSTED=week

# Máximo de vagas novas por notificação (para não spammar o WhatsApp)
MAX_JOBS_PER_RUN=15

# Se "true", só notifica vagas em São Paulo (estado) ou remotas
FILTER_SAO_PAULO=true
