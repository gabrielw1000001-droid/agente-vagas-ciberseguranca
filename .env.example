# === Credenciais da JSearch API (OpenWeb Ninja - endpoint direto) ===
# 1. Crie uma conta em https://app.openwebninja.com/signup (não precisa de cartão)
# 2. Assine (plano gratuito) a JSearch API: https://www.openwebninja.com/api/jsearch
# 3. Copie sua API Key (no painel do app.openwebninja.com) e cole abaixo
OPENWEBNINJA_API_KEY=coloque_sua_chave_aqui

# === Credenciais do Telegram (notificações) ===
# 1. Abra o Telegram e converse com @BotFather
# 2. Envie o comando: /newbot
# 3. Escolha um nome e um username para o bot (o username precisa terminar em "bot")
# 4. O BotFather vai te dar um token, tipo: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyz
# 5. Cole o token abaixo em TELEGRAM_BOT_TOKEN
# 6. Envie qualquer mensagem para o SEU bot recém-criado (procure pelo username dele)
# 7. Abra no navegador: https://api.telegram.org/bot<SEU_TOKEN>/getUpdates
# 8. Procure por "chat":{"id": NUMERO ...} na resposta e copie esse NUMERO abaixo
TELEGRAM_BOT_TOKEN=coloque_seu_token_aqui
TELEGRAM_CHAT_ID=coloque_seu_chat_id_aqui

# === Configurações de busca ===
# Palavras-chave separadas por vírgula
SEARCH_KEYWORDS=Suporte de TI,Segurança da Informação

# País alvo (código ISO de 2 letras)
SEARCH_COUNTRY=br

# Vagas postadas nos últimos: today | 3days | week | month
DATE_POSTED=week

# Máximo de vagas novas por notificação (para não spammar o WhatsApp)
MAX_JOBS_PER_RUN=15

# Se "true", só notifica vagas em São Paulo (estado) ou remotas
FILTER_SAO_PAULO=true
